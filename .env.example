# =============================================================================
# NAWWAR — Environment Configuration Template
# =============================================================================
# Copy this file to `.env` before running Docker Compose:
#   cp .env.example .env
#
# SECURITY RULE:
# - Never commit `.env` or real credentials to Git.
# - This file (`.env.example`) must contain documented placeholders ONLY.
# - Replace all `CHANGE_ME_*` placeholders with strong secrets in real environments.
# =============================================================================

# -----------------------------------------------------------------------------
# Application Environment
# -----------------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Production
TZ=UTC

# -----------------------------------------------------------------------------
# Host Port Bindings
# -----------------------------------------------------------------------------
# Port exposed by the frontend / reverse proxy container (`docker-compose.yml`).
NAWWAR_WEB_PORT=8090

# Development-only host ports (`docker-compose.dev.yml`).
NAWWAR_FRONTEND_DEV_PORT=5173
NAWWAR_API_DEV_PORT=5080
NAWWAR_DB_DEV_PORT=54329

# -----------------------------------------------------------------------------
# PostgreSQL Database
# -----------------------------------------------------------------------------
# Bootstrap superuser used only by the container entrypoint on first volume init.
POSTGRES_DB=nawwar
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_postgres_superuser_password

# Least-privilege application role created by `infra/postgres/init/10-create-app-role.sh`
# and used by the ASP.NET Core API (`Nawwar.Api`).
NAWWAR_DB_USER=nawwar_app
NAWWAR_DB_PASSWORD=CHANGE_ME_nawwar_app_password

# -----------------------------------------------------------------------------
# Optional S3-Compatible Object Storage (RustFS — `--profile storage`)
# -----------------------------------------------------------------------------
# Used for 3D glTF/GLB assets, textures, images, and audio when enabled:
#   docker compose --profile storage up --build -d
S3_ACCESS_KEY=CHANGE_ME_s3_access_key
S3_SECRET_KEY=CHANGE_ME_s3_secret_key
S3_REGION=us-east-1
S3_BUCKET_ASSETS=nawwar-assets
NAWWAR_S3_API_PORT=9000
NAWWAR_S3_CONSOLE_PORT=9001

